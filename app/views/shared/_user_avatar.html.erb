<%# 投稿者アイコン
  locals:
    user: 表示対象のユーザー
    size: 大きさ（省略時 :sm = 一覧カード / :md = 詳細画面）

  DaisyUI の avatar-placeholder（中身が画像ではなく文字のアバター）に
  名前の頭文字を表示する。色は user.id から決まるので、同じ人は常に同じ色になる。
%>
<div class="avatar avatar-placeholder">
  <div class="rounded-full <%= user_avatar_size_class(local_assigns.fetch(:size, :sm)) %> <%= user_avatar_color_class(user) %>">
    <span class="font-bold"><%= user_avatar_initial(user) %></span>
  </div>
</div>
