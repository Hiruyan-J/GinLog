<header class="sticky top-0 z-50 py-2 px-2 shadow-sm md:px-4 navbar bg-base-200 text-primary">
<!-- マイアカウント・ログイン -->
  <div class="navbar-start">
    <% if user_signed_in? %>
      <!-- マイアカウントボタン表示 -->
      <%= link_to mypage_path, class: "btn btn-ghost btn-circle md:btn-md" do %>
        <%= render "shared/user_avatar", user: current_user, size: :sm %>
      <% end %>
    <% else %>
      <!-- ログインボタン表示 -->
      <%= link_to new_user_session_path, class: "flex gap-1 items-center btn btn-ghost btn-sm text-primary md:btn-md" do %>
        <span class="material-symbols-rounded ms-size-20 md:ms-size-24">login</span>
        <span><%= t('header.login') %></span>
      <% end %>
    <% end %>
  </div>

  <!-- ロゴ表示 -->
  <div class="navbar-center">
    <%= link_to root_path, class: "p-0 btn btn-ghost text-primary" do %>
      <%= inline_svg_tag "ginlog_logo.svg", class: "w-auto h-14" %>
    <% end %>
  </div>

  <!-- ハンバーガーメニュー -->
  <div class="navbar-end">
    <div class="dropdown dropdown-end">
      <button type="button" class="btn btn-ghost btn-circle text-primary md:btn-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /> </svg>
      </button>
      <ul tabindex="-1" class="z-10 p-2 mt-3 w-52 shadow menu menu-md dropdown-content bg-base-300 text-base-content rounded-box">
        <%# 主なページ %>
        <li>
          <h2 class="menu-title"><%= t('header.main_menu_title') %></h2>
          <ul>
            <li><%= link_to t('header.home'), root_path %></li>
            <li><%= link_to t('header.sake_search'), sakes_path %></li>
            <li><%= link_to t('header.my_log'), sake_logs_path %></li>
            <li><%= link_to t('header.analyze_preferences'), preference_analysis_path %></li>
          </ul>
        </li>

        <%# アカウント関連（ログイン中はマイアカウント・ログアウト、未ログインはログイン・新規登録） %>
        <li class="mt-2">
          <h2 class="menu-title"><%= t('header.account_menu_title') %></h2>
          <ul>
            <% if user_signed_in? %>
              <li><%= link_to t('header.my_account'), mypage_path %></li>
              <li><%= link_to t('header.logout'), destroy_user_session_path, data: { turbo_method: :delete } %></li>
            <% else %>
              <li><%= link_to t('header.login'), new_user_session_path %></li>
              <li><%= link_to t('header.sign_up'), new_user_registration_path %></li>
            <% end %>
          </ul>
        </li>

        <%# 吟ログについて %>
        <li class="mt-2">
          <h2 class="menu-title"><%= t('header.about_menu_title') %></h2>
          <ul>
            <li><%= link_to t('header.terms'), terms_path %></li>
            <li><%= link_to t('header.privacy'), privacy_path %></li>
            <li><%= link_to t('header.contact'), contact_path %></li>
          </ul>
        </li>

        <%# データについて %>
        <li class="mt-2">
          <h2 class="menu-title"><%= t('header.data_menu_title') %></h2>
          <ul>
            <li>
              <%= link_to t('header.sakenowa_attribution'), "https://sakenowa.com",
                  target: "_blank", rel: "noopener noreferrer", class: "text-xs" %>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</header>
