<%# locals: (f:, attribute:, low_label:, high_label:, min:, max:, default_value:, required: false) -%>
<%# スライダー 1 つ分の入力欄（未入力 = 灰色。送信するのは hidden field だけ）
    f             … フォームビルダー
    attribute     … 項目名（例: :aroma_strength, :sweetness_intensity）
    low_label / high_label … 両端の表示
    min / max     … スライダーの範囲
    default_value … 未入力のときのつまみの位置
    required      … 必須か（true ならクリアボタンを出さず、未入力では送信できない） %>
<div data-controller="clearable-field"
     data-clearable-field-blank-class="opacity-40 grayscale"
     data-clearable-field-required-value="<%= required %>">
  <div class="flex justify-between items-center">
    <%= f.label attribute, class: class_names("font-semibold", "whitespace-nowrap required": required) %>
    <% unless required %>
      <%# クリアボタン %>
      <button type="button" class="btn btn-outline btn-xs btn-primary"
              data-action="clearable-field#clear">クリア</button>
    <% end %>
  </div>

  <%# 実際に送信される値（空文字 = 記録なし） %>
  <%= f.hidden_field attribute, id: nil, data: { clearable_field_target: "value" } %>

  <div data-clearable-field-target="display">
    <%# name: nil … スライダーは常に値を送ってしまうため送信しない %>
    <%# click … 灰色のときにつまみの位置そのままをタップしても記録ありにする %>
    <%= render "sake_logs/range_slider",
          f: f, attribute: attribute,
          min: min, max: max,
          low_label: low_label, high_label: high_label,
          range_options: {
            name: nil,
            value: f.object.public_send(attribute) || default_value,
            data: { clearable_field_target: "input",
                    action: "input->clearable-field#record click->clearable-field#record" }
          } %>
  </div>
</div>
