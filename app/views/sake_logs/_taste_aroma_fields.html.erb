<%# locals: (f:) -%>
<%# f … フォームビルダー（f.object が SakeLogForm） %>
<%# tag.details の open: は false なら属性ごと出力されない %>
<%= tag.details class: "w-full border collapse collapse-arrow border-base-300",
      open: f.object.taste_aroma_recorded? do %>
  <summary class="font-semibold collapse-title">
    味・香りの詳細記録<span class="ml-1 text-xs font-normal text-base-content/50">（任意）</span>
  </summary>

  <div class="flex flex-col gap-6 collapse-content">
    <%# 香りの詳細記録（見出しの横に評価の基準の注記） %>
    <div class="flex flex-wrap gap-x-2 items-baseline border-b border-primary">
      <h3 class="font-semibold">香り</h3>
      <span class="text-xs text-base-content/50">（<%= AromaProfile::EVALUATION_NOTE %>）</span>
    </div>

    <%# 吟醸香・原料香・熟成香（強弱スライダー → 区切り線 → 香りの種類タグ） %>
    <% AromaProfile::INTENSITY_ATTRIBUTES.each do |category, attribute| %>
      <div class="flex flex-col gap-3">
        <%= render "sake_logs/intensity_field",
              f: f, attribute: attribute, low_label: "弱い", high_label: "強い",
              min: AromaProfile::INTENSITY_MIN, max: AromaProfile::INTENSITY_MAX,
              default_value: AromaProfile::INTENSITY_DEFAULT,
              description: AromaProfile::DESCRIPTIONS[category] %>
        <%= render "sake_logs/aroma_tag_field",
              aroma_tags: f.object.aroma_tags_by_category.fetch(category, []),
              selected_ids: f.object.selected_aroma_tag_ids %>
      </div>
    <% end %>
    <%# タグを全部外したときも「空の配列」が送信されるようにする（無いとタグが外れない） %>
    <%= hidden_field_tag "sake_log[aroma_tag_ids][]", "", id: nil %>

    <%# 味の詳細記録 %>
    <h3 class="font-semibold border-b border-primary">味わい</h3>

    <%# 甘味・旨味・酸味・熟成度・余韻 %>
    <% TasteProfile::INTENSITY_SCALES.each do |attribute, (low_label, high_label)| %>
      <%= render "sake_logs/intensity_field",
            f: f, attribute: attribute, low_label: low_label, high_label: high_label,
            min: TasteProfile::INTENSITY_MIN, max: TasteProfile::INTENSITY_MAX,
            default_value: TasteProfile::INTENSITY_DEFAULT %>
    <% end %>

    <%# 炭酸感（1つだけ選ぶ。全部未選択 = 記録なし） %>
    <div data-controller="clearable-field"
         data-clearable-field-blank-class="opacity-40 grayscale">
      <div class="flex justify-between items-center">
        <span class="font-semibold"><%= SakeLogForm.human_attribute_name(:carbonation) %></span>
        <button type="button" class="btn btn-outline btn-xs btn-primary"
                data-action="clearable-field#clear">クリア</button>
      </div>

      <%# 実際に送信される値（空文字 = 記録なし） %>
      <%= f.hidden_field :carbonation, id: nil, data: { clearable_field_target: "value" } %>

      <div class="pl-4 mt-2" data-clearable-field-target="display">
        <%# join … ボタン同士をくっつけて1本の帯にする（daisyUI） %>
        <div class="w-full join">
          <% TasteProfile::CARBONATION_LABELS.each do |key, label| %>
            <%# has-checked: … 中のラジオが選ばれていたら緑に塗る %>
            <label class="flex-1 font-normal join-item btn btn-sm has-checked:bg-primary has-checked:text-primary-content">
              <%# name はラジオ同士を1グループにするためのダミー（送信するのは上の hidden field） %>
              <%# ラジオ自体は隠し、label をボタンとして押させる %>
              <%= radio_button_tag "carbonation_choice", key, f.object.carbonation == key,
                    class: "hidden",
                    data: { clearable_field_target: "input", action: "change->clearable-field#record" } %>
              <%= label %>
            </label>
          <% end %>
        </div>
        <div class="flex justify-between px-1 mt-1 text-xs">
          <span>弱い</span>
          <span>強い</span>
        </div>
      </div>
    </div>
  </div>
<% end %>
