<% content_for :title,  t('.title') %>
<% sake_name = "#{@sake_log.sake.brand.name} #{@sake_log.sake.product_name}" %>
<% set_meta_tags description: "#{@sake_log.user.name}さんの日本酒の記録「#{sake_name}」",
                 canonical: sake_log_url(@sake_log),
                 og: { title: "#{sake_name}｜#{@sake_log.user.name}さんの記録",
                       url: sake_log_url(@sake_log),
                       image: sake_log_ogp_image_url(@sake_log) } %>

<%# data-action は「Turbo がこのページをキャッシュする直前に close を呼ぶ」指定 %>
<div class="w-full" data-controller="image-modal"
     data-action="turbo:before-cache@document->image-modal#close">
  <%= page_heading %>

  <article id="<%= dom_id @sake_log %>" class="p-2">
    <%# 投稿者・記録日時 + 各種ボタン %>
    <section class="flex justify-between items-start">
      <div class="flex gap-2 items-center">
        <%= render "shared/user_avatar", user: @sake_log.user, size: :md %>
        <div>
          <p class="font-semibold"><%= @sake_log.user.name %></p>
          <%# 記録日時 %>
          <p class="text-xs text-neutral-500"><%= l @sake_log.created_at, format: :long %></p>
        </div>
      </div>

      <div class="flex gap-1 buttons">
        <% if current_user&.own?(@sake_log) %>
          <%# 編集ボタン %>
          <%= link_to edit_sake_log_path(@sake_log),
                id: "button-edit-#{@sake_log.id}",
                class: "btn btn-ghost btn-circle btn-sm" do %>
            <span class="material-symbols-rounded text-primary ms-size-24">edit_square</span>
          <% end %>
          <%# 削除ボタン %>
          <%= link_to sake_log_path(@sake_log),
                id: "button-delete-#{@sake_log.id}",
                class: "btn btn-ghost btn-circle btn-sm",
                data: { turbo_method: :delete, turbo_confirm: t('defaults.delete_confirm') } do %>
            <span class="material-symbols-rounded text-primary ms-size-24">delete</span>
          <% end %>
        <% end %>
      </div>
    </section>

    <%# 銘柄名・商品名・蔵元名・都道府県名 %>
    <section class="mt-1">
      <div class="flex flex-wrap gap-x-2 items-baseline">
        <h2 class="text-2xl font-bold"><%= brand_link @sake_log.sake.brand %></h2>
        <p class="text-base"><%= product_name_link @sake_log.sake %></p>
      </div>
      <p class="mt-1 text-sm text-neutral-500"><%= brewery_and_area_links @sake_log.sake.brand.brewery %></p>
    </section>

    <%# 好み度 %>
    <section class="mt-2">
      <div class="flex gap-0 items-center">
        <% SakeLog::RATING_MAX.times do |rate| %>
          <span class="inline-block w-5 h-5 mask mask-star-2 <%= star_rating_class(rate, @sake_log.rating) %>"></span>
        <% end %>
      </div>
    </section>

    <%# ラベル画像 %>
    <%= render "label_images", sake_log: @sake_log %>

    <%# 味 × 香りの4象限マップ（点プロット） %>
    <section class="flex flex-col items-center my-6">
      <%= render "shared/taste_aroma_map", taste: @sake_log.taste_strength, aroma: @sake_log.aroma_strength, variant: :plot, size: :lg %>
      <p class="mt-3 text-xs text-neutral-500">
        味の濃淡 <%= @sake_log.taste_strength %> ／ 香りの濃淡 <%= @sake_log.aroma_strength %>
      </p>
    </section>

    <%# 感想 %>
    <% if @sake_log.review.present? %>
      <section class="mt-4">
        <h3 class="text-sm font-semibold text-neutral-500">感想</h3>
        <%= simple_format(h(@sake_log.review), class: "py-2") %>
      </section>
    <% end %>

    <%# いいね・コメント・シェア %>
    <footer class="flex justify-around items-center pt-3 mt-6 border-t border-base-300">
      <%# いいね %>
      <%= render "likes/like_button", sake_log: @sake_log %>
      <%# コメント %>
      <%= render "comments/comment_button", sake_log: @sake_log, path: "#comments" %>
      <%# シェア %>
      <%= render "shared/share_button",
            text: sake_log_share_text(@sake_log, owned: current_user&.own?(@sake_log)),
            url: sake_log_url(@sake_log),
            hashtags: share_hashtags(@sake_log.sake),
            dropdown_class: "dropdown-top dropdown-end" %>
    </footer>

    <%# コメント欄 %>
    <%# scroll-mt-20 … #comments へ移動したとき見出しが固定ヘッダーに隠れないようにする余白 %>
    <section id="comments" class="mt-6 scroll-mt-20">
      <h3 class="text-sm font-semibold text-neutral-500">コメント</h3>

      <div id="comments_list" class="divide-y divide-base-300">
        <%# only:block は「この要素しか無いときだけ表示」。コメントが増減すると自動で出し分けられる %>
        <p class="hidden py-4 text-sm text-center only:block text-neutral-400">まだコメントはありません</p>
        <%= render partial: "comments/comment", collection: @comments %>
      </div>

      <% if user_signed_in? %>
        <div id="comment_form" class="mt-3">
          <%= render "comments/form", sake_log: @sake_log, comment: Comment.new %>
        </div>
      <% else %>
        <div class="mt-3 text-center">
          <%= link_to "ログインしてコメントする", new_user_session_path, class: "btn btn-outline btn-primary btn-sm" %>
        </div>
      <% end %>
    </section>

    <%# 戻るリンク %>
    <% back_label, back_path = sake_log_back_link(origin: @origin, owned: current_user&.own?(@sake_log), sake_id: @sake_log.sake_id) %>
    <section class="flex flex-wrap gap-2 justify-center mt-6">
      <%= link_to back_label, back_path, class: "btn btn-outline btn-primary" %>
      <%# 戻り先がタイムラインでないときだけ、タイムラインへの導線を出す %>
      <% if back_path != timeline_path %>
        <%= link_to "タイムラインで見る", timeline_path, class: "btn btn-primary" %>
      <% end %>
    </section>
  </article>

  <%= render "image_modal" %>
</div>
