<%# ブラウザタブ・OGP 用のタイトル %>
<% content_for :title, "#{@sake.brand.name} #{@sake.product_name}" %>
<%# X などでシェアされたときのカードの説明文 %>
<% set_meta_tags description: "#{@sake.brand.name} #{@sake.product_name}（#{@sake.brand.brewery.name}／#{@sake.brand.brewery.area.name}）の、みんなのテイスティング記録と味・香りの傾向をチェックできます。" %>

<div class="w-full">
  <article class="p-2">
    <%# ---------- ヘッダ: 銘柄名・商品名・蔵元名・都道府県名・シェアボタン ---------- %>
    <section class="flex gap-2 justify-between items-start mt-1">
      <div>
        <div class="flex flex-wrap gap-x-2 items-baseline">
          <h1 class="text-2xl font-bold"><%= brand_link @sake.brand %></h1>
          <%# 商品名は、この画面そのものなのでリンクにしない %>
          <p class="text-base"><%= @sake.product_name %></p>
        </div>
        <p class="mt-1 text-sm text-neutral-500"><%= brewery_and_area_links @sake.brand.brewery %></p>
      </div>

      <%= render "shared/share_button",
            text: sake_share_text(@sake),
            url: sake_url(@sake),
            hashtags: share_hashtags(@sake),
            dropdown_class: "dropdown-end shrink-0" %>
    </section>

    <% if @sake.aggregated? %>
      <%# ---------- 好み度の平均（星 ＋ 数値 ＋ 件数） ---------- %>
      <section class="flex gap-2 items-center mt-2">
        <%= render "shared/rating_stars", rating: @sake.average_rating, size: :lg %>
        <p class="text-sm text-neutral-500">
          <%= @sake.average_rating.round(1) %>（<%= @sake.sake_logs_count %>件の平均）
        </p>
      </section>

      <%# ---------- 味 × 香りの4象限マップ（平均値） ---------- %>
      <section class="flex flex-col items-center my-6">
        <%= render "shared/taste_aroma_map", taste: @sake.average_taste_strength, aroma: @sake.average_aroma_strength, variant: :plot, size: :lg %>
        <p class="mt-3 text-xs text-neutral-500">
          味の濃淡 <%= @sake.average_taste_strength.round(1) %> ／ 香りの濃淡 <%= @sake.average_aroma_strength.round(1) %>
        </p>
      </section>
    <% else %>
      <%# 投稿直後はジョブ実行前で集計値が入っていないことがある %>
      <p class="my-6 text-sm text-center text-neutral-500">集計中です。しばらくしてから開き直してください。</p>
    <% end %>

    <%# ---------- みんなの記録（無限スクロール） ---------- %>
    <section class="mt-6">
      <h2 class="pb-1 text-sm font-semibold border-b border-base-300 text-neutral-500">みんなの記録</h2>
      <% if @sake_logs.any? %>
        <div id="sake_records" class="flex flex-col gap-0 divide-y">
          <%# origin: "sake" を渡すと、カードから開いた記録詳細の「戻る」がこの画面に戻ってくる %>
          <%= render partial: "timelines/sake_log", collection: @sake_logs, locals: { origin: "sake" } %>
          <%# 2ページ目以降を遅延読み込みする Turbo Frame %>
          <%= render "next_page_frame", sake_logs: @sake_logs, sake: @sake %>
        </div>
      <% else %>
        <p class="my-10 text-center">まだ記録がありません</p>
      <% end %>
    </section>
  </article>
</div>
