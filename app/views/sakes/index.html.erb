<% content_for :title, t('.title') %>

<div class="w-full">
  <%= page_heading %>

  <%# 検索フォーム（GET なので検索条件が URL に残る） %>
  <%= form_with url: sakes_path, method: :get, class: "px-2 w-full", data: { controller: "auto-submit" } do |f| %>
    <% @filter_params.except(:quadrants).each do |key, id| %>
      <%= f.hidden_field key, value: id %>
    <% end %>
    <div class="flex w-full join">
      <%= f.search_field :keyword, value: @keyword, placeholder: t('.placeholder'), class: "w-full input input-primary join-item" %>
      <button type="submit" class="btn btn-primary join-item">
        <span class="material-symbols-rounded">search</span>
      </button>
    </div>

    <%# 4象限での絞り込み（最初は閉じている。象限を選んでいるときは開く） %>
    <%= render "quadrant_filter", selected_quadrants: @quadrants %>
  <% end %>

  <%# 絞り込み条件と「解除」リンク（条件がなければ何も出ない） %>
  <%= render "filter_conditions", filters: @filters, filter_params: @filter_params, keyword: @keyword %>

  <% if @sakes.any? %>
    <div id="sakes" class="flex flex-col gap-0 mt-2 divide-y">
      <%# render @sakes は、1件ごとに sakes/_sake.html.erb を描画する %>
      <%= render @sakes %>
      <%# 2ページ目以降を遅延読み込みする Turbo Frame %>
      <%= render "next_search_page_frame", sakes: @sakes, keyword: @keyword, filter_params: @filter_params %>
    </div>
  <% elsif @filter_params.any? %>
      <%# 絞り込み中で検索結果0件の場合は、キーワードがあっても「条件に一致する…」にする
        （キーワードだけなら見つかるのに「キーワードに一致しない」と誤解させないため） %>
    <p class="my-10 text-center"><%= t('.filtered_not_found') %></p>
  <% elsif @keyword.present? %>
    <p class="my-10 text-center"><%= t('.not_found', keyword: @keyword) %></p>
  <% else %>
    <p class="my-10 text-center"><%= t('.no_sakes') %></p>
  <% end %>
</div>
