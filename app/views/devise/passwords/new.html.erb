<% content_for :title,  t('.forgot_your_password') %>
<%= page_heading %>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "flex flex-col gap-4 items-center py-2" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="w-full md:w-8/12 field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full input input-primary" %>
  </div>

  <div class="flex justify-center actions">
    <%= f.submit t('.send_me_reset_password_instructions'), class: "btn btn-primary" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
