<% content_for :title,  t('.change_your_password') %>
<%= page_heading %>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "flex flex-col gap-4 items-center py-2" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="w-full md:w-8/12 field">
    <%= f.label :password, t('.new_password') %>
    <% if @minimum_password_length %>
      <em><%= t('devise.shared.minimum_password_length', count: @minimum_password_length) %></em>
    <% end %><br />
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full input input-primary" %>
  </div>

  <div class="w-full md:w-8/12 field">
    <%= f.label :password_confirmation, t('.confirm_new_password') %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full input input-primary" %>
  </div>

  <div class="flex justify-center pt-2 actions">
    <%= f.submit t('.change_my_password'), class: "btn btn-primary" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
