<% content_for :title, t('.title') %>
<%= page_heading %>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "flex flex-col gap-4 items-center py-2" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="w-full md:w-8/12 field">
    <%= f.label :name %><br />
    <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "w-full input input-primary" %>
  </div>

  <div class="w-full md:w-8/12 field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autocomplete: "email", class: "w-full input input-primary" %>
  </div>

  <%# メールアドレスを変更したあと、新しいアドレスの確認が済むまで表示される %>
  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div class="w-full md:w-8/12 alert alert-info">
      <%= t('.currently_waiting_confirmation_for_email', email: resource.unconfirmed_email) %>
    </div>
  <% end %>

  <div class="w-full md:w-8/12 field">
    <%= f.label :password %>
    <em class="text-sm"><%= t('.leave_blank_if_you_don_t_want_to_change_it') %></em>
    <% if @minimum_password_length %>
      <em class="text-sm"><%= t('devise.shared.minimum_password_length', count: @minimum_password_length) %></em>
    <% end %><br />
    <%= f.password_field :password, autocomplete: "new-password", class: "w-full input input-primary" %>
  </div>

  <div class="w-full md:w-8/12 field">
    <%= f.label :password_confirmation %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full input input-primary" %>
  </div>

  <div class="w-full md:w-8/12 field">
    <%= f.label :current_password %>
    <em class="text-sm"><%= t('.we_need_your_current_password_to_confirm_your_changes') %></em><br />
    <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full input input-primary" %>
  </div>

  <div class="flex justify-center pt-2 actions">
    <%= f.submit t('.update'), class: "btn btn-primary" %>
  </div>
<% end %>

<div class="flex justify-center py-2">
  <%= link_to t('devise.shared.links.back'), mypage_path, class: "link link-info" %>
</div>

<%# 退会 %>
<section class="flex flex-col gap-3 items-center py-6 mt-6 border-t border-base-300">
  <p class="w-full text-sm md:w-8/12"><%= t('.unhappy') %></p>
  <%= button_to t('.cancel_my_account'), registration_path(resource_name),
        method: :delete,
        data: { turbo_confirm: t('.are_you_sure') },
        class: "btn btn-outline btn-error" %>
</section>
