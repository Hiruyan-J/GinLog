<section class="flex flex-col gap-2 items-center py-2">
  <%- if controller_name != 'sessions' %>
    <%= link_to t(".sign_in"), new_session_path(resource_name), class: "link link-info" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to t(".sign_up"), new_registration_path(resource_name), class: "link link-info" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to t(".forgot_your_password"), new_password_path(resource_name), class: "link link-info" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to t('.didn_t_receive_confirmation_instructions'), new_confirmation_path(resource_name), class: "link link-info" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to t('.didn_t_receive_unlock_instructions'), new_unlock_path(resource_name), class: "link link-info" %>
  <% end %>

  <%# Google ログイン（ログイン画面と新規登録画面だけに出す） %>
  <%- if devise_mapping.omniauthable? && controller_name.in?(%w[sessions registrations]) %>
    <div class="self-center w-full md:w-8/12 divider"><%= t('.or') %></div>
    <%= button_to omniauth_authorize_path(resource_name, :google_oauth2),
          data: { turbo: false },
          class: "bg-white btn border-[#747775] text-[#1f1f1f]" do %>
      <%= image_tag "google_g_logo.svg", alt: "", class: "size-5" %>
      <%= t('.sign_in_with_provider', provider: "Google") %>
    <% end %>
  <% end %>
</section>
