<%# いいね数
  locals:
    sake_log:   対象の記録
    show_heart: 件数の左にハートも出すか（省略時 false）
    compact:    スマホ幅でアイコンと余白を詰めるか（省略時 false）
%>
<% like_count = sake_log.likes.size %>
<% show_heart = local_assigns.fetch(:show_heart, false) %>
<% compact = local_assigns.fetch(:compact, false) %>
<% size_class = compact ? "gap-0 px-0 md:gap-1 md:px-1 md:min-w-8" : "gap-1 px-1 min-w-8" %>
<% icon_size_class = compact ? "ms-size-16 md:ms-size-20" : "ms-size-20" %>
<% count_content = capture do %>
  <% if show_heart %>
    <% liked = user_signed_in? && sake_log.liked_by?(current_user) %>
    <span class="material-symbols-rounded <%= icon_size_class %> <%= liked ? "ms-fill text-error" : "text-primary" %>">favorite</span>
  <% end %>
  <span class="text-xs text-neutral-500"><%= like_count %></span>
<% end %>

<% if like_count.positive? %>
  <%= link_to count_content, sake_log_likes_path(sake_log),
        class: "justify-start #{size_class} btn btn-ghost btn-sm",
        data: { turbo_frame: "likes_modal_frame" } %>
<% else %>
  <%= tag.span count_content, class: "inline-flex justify-start items-center h-8 #{size_class}" %>
<% end %>
