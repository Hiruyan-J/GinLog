<!DOCTYPE html>
<html>
  <head>
    <%= display_meta_tags(default_meta_tags) %>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%# アイコン用フォント。<link> で読むと ms-size-* が効かないため、@import で base レイヤーに入れる %>
    <%# tailwind.css より後ろに置く。新しいアイコンを使うときは icon_names に名前を足す（アルファベット順） %>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400..700,0..1,0&icon_names=add_a_photo,add_circle,android,chat_bubble,chevron_right,computer,content_copy,delete,download,edit_square,expand_more,favorite,home,keyboard_arrow_down,lists,login,more_horiz,no_photography,phone_iphone,search,share,star&display=block') layer(base);
    </style>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VJVYRQKGYH"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // アプリとして開いているか（standalone / browser）を、ページビューと一緒に送る
      gtag('config', 'G-VJVYRQKGYH', {
        display_mode: window.matchMedia('(display-mode: standalone)').matches || navigator.standalone === true ? 'standalone' : 'browser'
      });
    </script>
  </head>

  <body class="flex flex-col min-h-screen">
    <%= render "shared/header" %>
    <% if content_for?(:full_width) %>
      <main class="flex-1 pb-14 md:pb-20">
        <div class="mx-auto w-full max-w-2xl">
          <%= render 'shared/flash_message' %>
        </div>
        <%= yield %>
      </main>
    <% else %>
      <main class="flex-1 px-4 pt-4 pb-14 mx-auto w-full max-w-2xl md:pb-20">
        <%= render 'shared/flash_message' %>
        <%= yield %>
      </main>
    <% end %>
    <%= render "shared/footer" %>
    <%= render "likes/modal" %>
  </body>
</html>
