<article id="<%= dom_id sake_log %>" class="relative py-3">
  <%= link_to "", sake_log_path(sake_log, from: "timeline"),
        class: "absolute inset-0 z-10",
        data: { turbo_frame: "_top" } %>

  <%# 投稿者・投稿日時・操作ボタン・好み度 %>
  <header class="flex gap-2 items-start">
    <%= render "shared/user_avatar", user: sake_log.user, size: :sm %>

    <div class="min-w-0">
      <%# 投稿者名 %>
      <p class="font-semibold truncate"><%= sake_log.user.name %></p>
      <%# 投稿日時（format: :long は "2026/08/02 21:30" 形式） %>
      <p class="text-xs text-neutral-500"><%= l sake_log.created_at, format: :long %></p>
    </div>

    <div class="flex flex-col gap-1 items-end ml-auto">
      <%# 編集・削除ボタン %>
      <div class="flex relative z-20 gap-2">
        <% if current_user&.own?(sake_log) %>
          <%# 編集ボタン %>
          <%= link_to edit_sake_log_path(sake_log),
                id: "button-edit-#{sake_log.id}",
                data: { turbo_frame: "_top" } do %>
            <span class="material-symbols-rounded text-primary ms-size-24">edit_square</span>
          <% end %>
          <%# 削除ボタン
            Turbo Stream で応答するため frame と無関係に動く。turbo_frame: "_top" は付けない %>
          <%= link_to sake_log_path(sake_log, from: "timeline"), id: "button-delete-#{sake_log.id}", data: { turbo_method: :delete, turbo_confirm: t('defaults.delete_confirm') } do %>
            <span class="material-symbols-rounded text-primary ms-size-24">delete</span>
          <% end %>
        <% end %>
      </div>

      <%# 好み度 %>
      <div class="flex gap-0 items-center">
        <% SakeLog::RATING_MAX.times do |rate| %>
          <span class="inline-block w-4 h-4 md:w-5 md:h-5 mask mask-star-2 <%= star_rating_class(rate, sake_log.rating) %>"></span>
        <% end %>
      </div>
    </div>
  </header>

  <%# 銘柄名・商品名・都道府県 %>
  <section class="flex flex-wrap gap-x-2 items-baseline mt-1">
    <h2 class="text-xl font-bold"><%= sake_log.sake.brand.name %></h2>
    <p class="text-sm"><%= sake_log.sake.product_name %></p>
    <span class="badge badge-ghost badge-sm"><%= sake_log.sake.brand.brewery.area.name %></span>
  </section>

  <%# ラベル画像（先頭2枚のみ。3枚目以降があれば最後のマスに +N バッジを重ねる） %>
  <% attached_images = sake_log.attached_images %>
  <% if attached_images.any? %>
    <% card_images = sake_log_card_images(attached_images) %>
    <% hidden_image_count = sake_log_hidden_image_count(attached_images) %>
    <section class="grid gap-1 mt-2 <%= sake_log_card_grid_class %>">
      <% card_images.each_with_index do |(_attachment_name, attachment), index| %>
        <div class="overflow-hidden relative rounded-lg aspect-[4/3] bg-base-200 <%= sake_log_card_image_class(card_images.size) %>">
          <%= sake_log_image_tag attachment, width: 600, class: "object-cover w-full h-full" %>
          <%# 残り枚数バッジは最後のマスにだけ重ねる %>
          <% if hidden_image_count.positive? && index == card_images.size - 1 %>
            <span class="absolute right-1 bottom-1 badge badge-neutral badge-sm">+<%= hidden_image_count %></span>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <%# 感想 %>
  <% if sake_log.review.present? %>
    <section class="mt-2">
      <%= simple_format(h(sake_log.review)) %>
    </section>
  <% end %>

  <%# いいね・コメント・シェア %>
  <footer class="flex justify-around items-center pt-2 mt-2 text-neutral-300">
    <%# いいね（未実装） %>
    <span class="material-symbols-rounded ms-size-24">favorite</span>
    <%# コメント（未実装） %>
    <span class="flex gap-1 items-center">
      <span class="material-symbols-rounded ms-size-24">chat_bubble</span>
      <span class="text-xs">0</span>
    </span>
    <%# シェア（未実装） %>
    <span class="material-symbols-rounded ms-size-24">share</span>
  </footer>
</article>
